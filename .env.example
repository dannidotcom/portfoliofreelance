# Gmail SMTP — utilise un "mot de passe d'application", pas ton mot de passe Google
# https://myaccount.google.com/apppasswords
EMAIL_USER=YOUR_EMAIL
EMAIL_PASS=YOUR_PASSWORD
# Optionnel : destinataire des notifications (défaut = EMAIL_USER)
# EMAIL_TO=alphonse.danni@gmail.com

# Optionnel : token GitHub (fine-grained, lecture seule, dépôts publics) pour afficher les dépôts épinglés.
# Sans token : sélection définie dans content/github.ts, métadonnées via l'API REST publique.
# GITHUB_TOKEN=

# Dev uniquement : afficher les champs TODO (jamais actif en production)
# NEXT_PUBLIC_SHOW_TODOS=1

# Source de la musique "coding focus" : youtube (défaut) ou local (fichier public/audio/coding-focus.mp3)
# NEXT_PUBLIC_FOCUS_AUDIO_SOURCE=local
